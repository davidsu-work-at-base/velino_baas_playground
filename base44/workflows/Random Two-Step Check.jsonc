{
  "name": "Random Two-Step Checkaa",
  "description": "A simple scheduled workflow that runs two steps every day at 9am",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "random_two_step_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "set_run_status": {
          "call": "calculate_field",
          "with": {
            "field": "run_status",
            "value": "started"
          },
          "then": "set_run_summary",
          "x-base44": {
            "title": "Set run status",
            "description": "Marks the run as started"
          }
        }
      },
      {
        "set_run_summary": {
          "call": "calculate_field",
          "with": {
            "field": "run_summary",
            "value": "Daily check completed"
          },
          "then": "end",
          "x-base44": {
            "title": "Set run summary",
            "description": "Writes a short summary"
          }
        }
      }
    ]
  }
}