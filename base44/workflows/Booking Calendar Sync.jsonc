{
  "name": "Booking Calendar Sync",
  "description": "Keeps every booking in sync with the connected Google Calendar whenever it is created, changed or removed",
  "trigger": {
    "condition": "${ (.trigger.changed_fields // []) | index(\"google_event_id\") == null }",
    "config": {
      "trigger_type": "entity",
      "entity_name": "Booking",
      "events": [
        "create",
        "update",
        "delete"
      ]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "booking_calendar_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_booking": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncBookingToCalendar",
            "args": {
              "booking_id": "${ .trigger.entity_id }",
              "event_type": "${ .trigger.event_type }",
              "google_event_id": "${ .trigger.data.google_event_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync booking to Google Calendar",
            "description": "Creates, updates or removes the matching calendar event"
          }
        }
      }
    ]
  }
}