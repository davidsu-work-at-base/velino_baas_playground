{
  "name": "Booking",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "Who the booking is for"
    },
    "service": {
      "type": "string",
      "description": "What is booked"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the booking (UTC)"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "End of the booking (UTC)"
    },
    "notes": {
      "type": "string",
      "description": "Extra details for the booking"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "default": "pending",
      "description": "Booking status"
    },
    "google_event_id": {
      "type": "string",
      "description": "Google Calendar event created for this booking"
    }
  },
  "required": [
    "customer_name",
    "start_time"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}